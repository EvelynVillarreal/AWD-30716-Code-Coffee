@startuml
title American Latin Class - ALCSystem v2.0.19 Class Diagram
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Model (Eloquent ORM)" {
  class Branch {
    +id
    +name
    +director_name
    +co_director_name
    +matrix_share_percent
  }

  class User {
    +id
    +name
    +email
    +role
    +branch_id
    +student_id
    +avatar_url
    +is_active
  }

  class Student {
    +id
    +branch_id
    +national_id
    +full_name
    +email
    +phone
    +level
    +scholarship_percent
    +photo_url
    +status
  }

  class ClassPlan {
    +id
    +branch_id
    +teacher_name
    +month
    +level
    +objective
    +activities
    +document_url
    +status
  }

  class AttendanceRecord {
    +id
    +branch_id
    +student_id
    +person_type
    +person_name
    +attendance_date
    +check_in_at
    +expected_start_time
    +duration_hours
    +pay_rate
    +status
    +source
    +evidence_code
  }

  class BranchFinanceReport {
    +id
    +branch_id
    +month
    +income
    +expenses
    +matrix_share_percent
    +matrix_share_amount
    +net_result
  }

  class ProfessionalEvent {
    +id
    +branch_id
    +client_name
    +event_type
    +event_date
    +total_amount
    +status
  }

  class DancerEventAssignment {
    +id
    +professional_event_id
    +student_id
    +gross_amount
    +deduction_amount
    +deduction_reason
    +payment_status
  }

  class AuditLog {
    +id
    +actor_user_id
    +actor_email
    +actor_role
    +branch_id
    +action
    +entity_type
    +entity_id
    +metadata
  }

  class DanceStyle {
    +id
    +name
  }

  class Level {
    +id
    +name
  }
}

package "Controller (Slim HTTP)" {
  class HomeController
  class BranchController
  class ReferenceDataController
  class EnrollmentController
  class AuthController
  class KioskController
  class TeacherAttendanceController
  class StudentController
  class TeacherController
  class ClassPlanController
  class AttendanceRecordController
  class FinanceController
  class ProfessionalEventController
  class ProfilePhotoController
}

package "Middleware" {
  class RoleMiddleware
}

package "Service" {
  class AuthService
  class JwtTokenService
  class AuthenticatedUser
  class BranchAccessService
  class DateRangeService
  class MonthlyDateRange
  class AttendanceSummaryService
  class TeacherPayrollService
  class EvidenceCodeGenerator
  class AuditLogger
  class ValidationService
}

package "Validation Services" {
  class FieldValidator
  class EcuadorianIdValidator
  class StudentValidator
  class TeacherAccountValidator
  class AttendanceValidator
  class PlanningValidator
  class FinanceValidator
  class EventValidator
  class ProfilePhotoValidator
}

package "Support" {
  class JsonResponder
  class DatabaseConnection
}

Branch "1" -- "many" User
Branch "1" -- "many" Student
Branch "1" -- "many" ClassPlan
Branch "1" -- "many" AttendanceRecord
Branch "1" -- "many" BranchFinanceReport
Branch "1" -- "many" ProfessionalEvent
Branch "1" -- "many" AuditLog

User "0..1" -- "1" Student : linked account
Student "1" -- "many" AttendanceRecord
Student "1" -- "many" DancerEventAssignment
ProfessionalEvent "1" -- "many" DancerEventAssignment

HomeController --> JsonResponder
